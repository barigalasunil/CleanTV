<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (WallpaperDream): the launcher's wallpapers with the clock and the date drifting over them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dreamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The clock and its shade move together, so the shade always sits behind the text. -->
    <FrameLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <View
            android:id="@+id/dreamScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/dreamText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextClock
                    android:id="@+id/dreamTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#E6FFFFFF"
                    android:textSize="120sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 200"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/dreamMeridiem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#99FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
            </LinearLayout>

            <TextClock
                android:id="@+id/dreamDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#8CFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
