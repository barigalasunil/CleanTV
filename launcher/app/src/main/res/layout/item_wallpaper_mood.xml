<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/moodTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.14"
        android:textAllCaps="true" />

    <LinearLayout
        android:id="@+id/moodRotate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/input_row_bg"
        android:focusable="true"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rotate_mood"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="11sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/moodCheck"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_check"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:visibility="gone"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
